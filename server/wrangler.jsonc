{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dam-cuoi-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "WEDDINGS", "class_name": "WeddingRoom" }]
  },
  // Gói Free của Cloudflare chỉ hỗ trợ Durable Object dạng SQLite
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WeddingRoom"] }],
  "vars": {
    // Ví dụ: "https://tenban.github.io" — để trống để cho phép mọi nơi
    "ALLOWED_ORIGINS": ""
  }
}
